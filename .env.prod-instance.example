# =============================================================================
# Prod-v2 Supabase instance — placeholders.
# Fill in once the new prod Supabase project exists, then:
#   - mirror these into GitHub repo secrets (PROD_* names, see deploy-prod.yml)
#   - keep a local copy as .env.prod-instance (gitignored) for running
#     db:push:prod / prod-admin-seed.sql from your machine
# =============================================================================

# Supabase project ref (dashboard → Project Settings → General)
SUPABASE_PROJECT_REF_PROD=

# Direct connection (port 5432) — required for migrations (supabase db push)
DATABASE_DIRECT_URL_PROD=

# Pooler connection (port 6543) — used by the app at runtime
PROD_DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL_PROD=
NEXT_PUBLIC_SUPABASE_ANON_KEY_PROD=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY_PROD=
SUPABASE_SERVICE_ROLE_KEY_PROD=

# App domain for the prod-v2 stack (Traefik Host rule + NEXT_PUBLIC_APP_URL)
PROD_DOMAIN=

# Generate a fresh key — do NOT reuse the dev/staging PROFILE_ENCRYPTION_KEY.
# PHI encrypted under this key is only decryptable with this key.
PROD_PROFILE_ENCRYPTION_KEY=

PROD_ADMIN_PASSKEY_SESSION_SECRET=

# Initial admin account — used once by prod-admin-seed.sql, then rotate the
# password via the Supabase dashboard after first login.
PROD_ADMIN_EMAIL=
PROD_ADMIN_INITIAL_PASSWORD=

PROD_FROM_EMAIL=
PROD_MCP_CLIENT_ID=
PROD_MCP_CLIENT_SECRET=
